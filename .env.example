# FoodieHelp AI Environment Configuration
# Copy this file to .env and fill in your values.

# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g., gemini-3.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# Local Embedding Model (Hugging Face sentence-transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG Retrieval Settings
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=4

# Storage Paths
DATABASE_PATH=data/foodiehelp.db
CHROMA_PERSIST_DIR=data/chroma_db
KNOWLEDGE_BASE_DIR=data/knowledge_base

